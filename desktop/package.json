{
  "name": "nutritiscan-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "A local human-biology research workspace powered by your own Codex sign-in",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "archive": "node scripts/archive.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "esbuild": "0.28.2",
    "playwright-core": "^1.63.0"
  }
}
