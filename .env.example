# Local: no account required. PGlite and encryption key live in ignored .local/.
# Production: PostgreSQL + a separate 32-byte hex key are mandatory.
DATABASE_URL=
HEALTH_DATA_KEY=
APP_ORIGIN=http://localhost:3000
# ---- Companion AI engine -------------------------------------------------
# First credential wins. With none of them set the companion still answers
# from its published reference notes and says so.
#   1. Gemini — use a project/tier approved for the health data you process.
#      Free tier prompts may be used to improve Google's products; use only
#      synthetic data there. Check current provider terms before real use.
GOOGLE_GENERATIVE_AI_API_KEY=
#   2. Vercel AI Gateway, when a card and a stronger model are wanted.
AI_GATEWAY_API_KEY=
# Do not copy VERCEL_OIDC_TOKEN into .env.local: it expires. Vercel supplies a
# fresh token in its runtime when Gateway authentication is configured.
#   3. Your own OpenAI-compatible endpoint (for example local Ollama's /v1).
HEALTH_MODEL_BASE_URL=
HEALTH_MODEL_NAME=
HEALTH_MODEL_API_KEY=
# For local thinking models such as Qwen 3.5, set to none if the model
# spends the short answer budget on reasoning and returns empty content.
HEALTH_MODEL_REASONING_EFFORT=
# Enable only after validating the model, processing terms and intended use.
HEALTH_MODEL_APPROVED=false
# --------------------------------------------------------------------------
# Old anonymous clinical endpoints are disabled by default.
LEGACY_CLINICAL_ENABLED=false

# Optional separately deployed FastAPI health service (server-only URL).
# The public chat remains available without this service.
HEALTH_API_URL=
# Google Identity Services Web client; configure the same ID as GOOGLE_CLIENT_ID
# on the FastAPI health service. The API independently verifies every ID token.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Evaluation experiment only; public supervisor uses one model by default.
HEALTH_MULTI_AGENT_ENABLED=false

# Shared public account proof (optional when HEALTH_DATA_KEY is configured).
ACCOUNT_SESSION_SECRET=
# Paid models require an explicit Gateway credential AND a verified subscription.
PREMIUM_AI_ENABLED=false
# AI_GATEWAY_API_KEY is declared above; keep it server-only.
BILLING_ENABLED=false
BILLING_PROVIDER=
BILLING_CURRENCY=INR
PRO_MONTHLY_PRICE_MINOR=
MAX_MONTHLY_PRICE_MINOR=
PRO_MONTHLY_AI_CREDITS=500
MAX_MONTHLY_AI_CREDITS=2000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_MAX_PRICE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_MAX_PLAN_ID=
RAZORPAY_TOTAL_COUNT=
# Apply the additive billing schema before use; see docs/SUBSCRIPTIONS.md.
