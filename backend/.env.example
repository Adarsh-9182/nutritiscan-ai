# Generate separate secrets before deployment; do not commit the resulting .env.
ENVIRONMENT=production
GOOGLE_CLIENT_ID=
HEALTH_DATABASE_URL=postgresql+psycopg://nutritiscan:CHANGE_ME@postgres:5432/nutritiscan
HEALTH_DATA_KEY=
POSTGRES_PASSWORD=
HEALTH_ALLOWED_ORIGINS=https://nutritiscan.com,https://www.nutritiscan.com
# Private S3-compatible bucket, pre-created; block public access and use scoped IAM.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
REDIS_URL=redis://redis:6379/0
# Optional one-call language rendering; disabled by default.
HEALTH_LLM_PROVIDER=none
HEALTH_LLM_MODEL=
HEALTH_LLM_KEY=
HEALTH_MODEL_APPROVED=false
# Do not enable content tracing with patient records.
LANGCHAIN_TRACING_V2=false
